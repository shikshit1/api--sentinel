# API Sentinel Server Environment Configuration

# Required: Storage Mode - Must be explicitly configured as "demo" or "mongodb"
# In "demo" mode, no external database is required.
# In "mongodb" mode, MONGODB_URI is required and the server will fail-fast if unreachable.
STORAGE_MODE=demo

# MongoDB connection string (only required when STORAGE_MODE=mongodb)
MONGODB_URI=mongodb://localhost:27017/api_sentinel

# Server port
PORT=4000
